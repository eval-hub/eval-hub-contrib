# LightEval adapter container for eval-hub
FROM registry.access.redhat.com/ubi9/python-312:latest

# Switch to root to set up directories
USER 0

# Set working directory
WORKDIR /app

# Install the fully pinned dependency set. The resolver is skipped (--no-deps)
# because pip 24.2 cannot resolve the unpinned requirements.txt (ResolutionTooDeep).
# The lock carries no pip entry of its own, so upgrade the installer first: pip 26.2.2
# verifies through truststore instead of the vendored bundle it ships with.
COPY requirements.lock .
RUN pip install --no-cache-dir --upgrade pip==26.2.2 && \
    pip install --no-cache-dir --no-deps -r requirements.lock

# IFEval is imported while LightEval builds its task registry and downloads
# these NLTK resources if they are not already available. Bundle them so
# registry initialization does not require egress in disconnected jobs.
ENV NLTK_DATA=/usr/local/share/nltk_data
RUN python -c "import nltk; [nltk.download(resource, download_dir='/usr/local/share/nltk_data', raise_on_error=True) for resource in ('punkt', 'punkt_tab')]; nltk.sent_tokenize('First sentence. Second sentence.')" && \
    chmod -R a+rX /usr/local/share/nltk_data

# Copy adapter implementation and loglikelihood patch
COPY main.py .
COPY _hf_offline.py ./
COPY lighteval_logprob_patch.py .
COPY lighteval_memory_cap.py .
COPY sample_results.py ./
COPY custom_tasks.py ./

# Create writable cache directories with proper permissions
# Make site-packages writable for lighteval to cache task data
RUN mkdir -p /tmp/.litellm_cache && \
    chmod -R 777 /tmp && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app && \
    chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV EVALHUB_MODE=k8s
ENV HOME=/tmp
ENV LITELLM_CACHE_DIR=/tmp/.litellm_cache

# Switch back to non-root user
USER 1001

# Run the adapter
ENTRYPOINT ["python", "main.py"]
