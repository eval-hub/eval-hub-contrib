FROM registry.access.redhat.com/ubi9/python-311:latest

WORKDIR /app

USER 0

# pyrit→pyodbc needs unixODBC; base2048 (pyrit dep) needs a Rust toolchain
# to build from source when no wheel matches the platform.
RUN dnf install -y unixODBC unixODBC-devel gcc gcc-c++ make rust cargo \
    && dnf clean all

COPY requirements.txt requirements-pyrit.txt constraints.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-pyrit.txt -c constraints.txt \
    && dnf remove -y rust cargo gcc gcc-c++ make unixODBC-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf /root/.cargo /root/.rustup

COPY main.py .

ENV PYTHONUNBUFFERED=1 \
    EVALHUB_MODE=k8s

USER 1001

ENTRYPOINT ["python", "main.py"]
