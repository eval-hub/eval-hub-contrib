FROM registry.access.redhat.com/ubi9/python-312:latest

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY _evaluation.py rules.py main.py provider.yaml ./
COPY data/ ./data/
