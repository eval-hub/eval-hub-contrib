# Inspect AI adapter container for eval-hub (downstream Konflux build)
#
# AIPCC base: ships the RHEL runtime libraries the curated-index wheels
# link against — openblas (libopenblasp.so.0) for the numpy/scipy C
# extensions, thrift (libthrift-0.24.0.so) for pyarrow's bundled
# libparquet, plus the rest of that wheel set's system-library closure
# (libre2, libsnappy, liblz4, libutf8proc, lcms2, openjpeg, libgfortran,
# ...). Plain ubi9/python-312 does not carry these libraries. The digest
# pin below is what Renovate keeps updated.
ARG BASE_IMAGE=quay.io/aipcc/base-images/cpu-el9.8:3.6.0@sha256:92ac64bfa88983126fc334a667629100e75192ae1b695bad90c7ca7abc9f8ac7
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

USER 0

WORKDIR /app

# ── Python dependencies ───────────────────────────────────────────────────────
# requirements-rhoai.txt is uv-compiled from requirements.txt against the RHOAI
# curated index (its --index-url is embedded in the file); every wheel in the
# lock — inspect-evals, eval-hub-sdk and petri-bloom included — resolves from
# that index, so the only direct URLs left are the two git deps, pinned as
# hashable archive URLs. Under hermetic Konflux builds, Hermeto's
# prefetched wheels are used instead via --no-index (see the file header).
COPY requirements-rhoai.txt .
RUN pip install --no-cache-dir -r requirements-rhoai.txt

# uv is build tooling inherited from the base image, not a runtime dependency.
RUN /opt/app-root/bin/python -m pip uninstall -y uv && \
    test ! -e /opt/app-root/bin/uv && \
    test ! -e /opt/app-root/bin/uvx

# ── NLTK data — bundled at build time ────────────────────────────────────────
#
# inspect_evals/makemesay/game.py::ensure_nltk_resource() needs three NLTK
# datasets for word tokenization (punkt, punkt_tab) and lemmatization (wordnet).
# It resolves the data directory via user_cache_dir("inspect_evals") from
# platformdirs, which honours XDG_CACHE_HOME.
#
# Setting XDG_CACHE_HOME=/app/.cache makes the resolved path
#   /app/.cache/inspect_evals/make_me_say/nltk_data
# a fixed location inside the image layer. When the data is present at build
# time, the RUN step below installs all three packages there, so
# ensure_nltk_resource() finds them immediately and makes zero network calls
# at runtime.
#
# LICENSING: nltk-data-airgap/ is intentionally NOT populated in this repo.
# The Punkt models (punkt, punkt_tab) carry no license at all — NLTK's own
# dataset licence overview (nltk_data DATASET-LICENSES.md) lists both as
# "no license attribute" — so they cannot be redistributed here or baked into
# the image. (WordNet 3.0's Princeton licence does permit redistribution, but
# makemesay needs all three datasets, so none are shipped.) The staging
# directory and the copy/extract logic below are kept so that a build whose
# licensing has been cleared can populate the directory and get bundling back
# with no other change:
#
# 1. On a connected host with redistribution rights, pre-download the NLTK
#    data into the build context:
#
#      python3 -c "
#        import nltk, pathlib
#        dest = pathlib.Path('nltk-data-airgap')
#        for pkg in ('punkt', 'punkt_tab', 'wordnet'):
#            nltk.download(pkg, download_dir=str(dest))
#      "
#
# 2. Build with the --build-arg NLTK_AIRGAP=true flag. When NLTK_AIRGAP=true
#    the RUN step below skips the network download and instead copies the
#    data from nltk-data-airgap/ in the build context. If that directory
#    holds no data (the default in this repo), the step skips NLTK bundling
#    entirely with a warning and the build succeeds — makemesay then needs
#    network egress at first use, or the data volume-mounted at the path
#    above.
#
# The base image must be available from your internal registry; mirror it
# if needed.
ENV XDG_CACHE_HOME=/app/.cache
# Pin the inspect_evals cache root explicitly so the NLTK data path is
# predictable regardless of the XDG_CACHE_HOME default and immune to
# INSPECT_EVALS_CACHE_DIR overrides at runtime. The value here must match the
# NLTK_DIR computed inside the RUN step below.
ENV INSPECT_EVALS_CACHE_DIR=/app/.cache/inspect_evals
# NLTK_AIRGAP=true  → never touch the network: copy nltk-data-airgap/ from the
#                     build context if it holds data, otherwise skip NLTK
#                     bundling with a warning (licensing: see above).
# NLTK_AIRGAP=false → download punkt, punkt_tab, wordnet from the internet (default).
ARG NLTK_AIRGAP=false

# Standard (connected) build: download exactly the three NLTK packages needed by
# inspect_evals/makemesay/game.py::ensure_nltk_resource() — nothing else.
#   punkt      -> tokenizers/punkt/     (word_tokenize, NLTK classic path)
#   punkt_tab  -> tokenizers/punkt_tab/ (word_tokenize, NLTK >= 3.8)
#   wordnet    -> corpora/wordnet/      (WordNetLemmatizer.lemmatize)
# Each download is verified; the build fails if any package is missing or corrupt.
# nltk.download() does not resolve transitive dependencies — only the named
# package is fetched per call.
COPY nltk-data-airgap/ /tmp/nltk-data-airgap/
RUN python3 - <<'PYEOF'
import nltk, pathlib, sys, os, shutil

# Derive the NLTK data path from INSPECT_EVALS_CACHE_DIR (set by the ENV
# instruction above) so the build path always matches the runtime path that
# ensure_nltk_resource() in makemesay/game.py resolves via user_cache_dir().
NLTK_DIR = pathlib.Path(os.environ['INSPECT_EVALS_CACHE_DIR']) / 'make_me_say' / 'nltk_data'
NLTK_DIR.mkdir(parents=True, exist_ok=True)

# Packages and their nltk.data.find() resource paths — exactly what
# ensure_nltk_resource() in makemesay/game.py looks for at runtime.
REQUIRED = {
    'punkt':     'tokenizers/punkt',
    'punkt_tab': 'tokenizers/punkt_tab',
    'wordnet':   'corpora/wordnet',
}

# Register our data directory so nltk.data.find() resolves correctly.
if str(NLTK_DIR) not in nltk.data.path:
    nltk.data.path.insert(0, str(NLTK_DIR))

airgap = os.environ.get('NLTK_AIRGAP', 'false').lower() == 'true'

if airgap:
    src = pathlib.Path('/tmp/nltk-data-airgap')
    # Exclude .gitkeep placeholder — only real NLTK data packages count.
    real_items = [p for p in src.iterdir() if p.name != '.gitkeep']
    if not real_items:
        # No data staged (the default in this repo — the Punkt models carry
        # no redistribution license; see the comment block above). Skip NLTK
        # bundling: the build succeeds, and makemesay's ensure_nltk_resource()
        # will attempt an on-demand download at first use (requires network
        # egress) or fail in disconnected deployments.
        print('WARNING: NLTK_AIRGAP=true but nltk-data-airgap/ holds no data.\n'
              'Skipping NLTK bundling; makemesay will need network access at\n'
              'first use, or the data mounted at '
              f'{NLTK_DIR}.', file=sys.stderr)
        sys.exit(0)
    # Copy pre-downloaded data from the build context staging area.
    for item in real_items:
        dest = NLTK_DIR / item.name
        if dest.exists():
            shutil.rmtree(dest) if dest.is_dir() else dest.unlink()
        shutil.copytree(item, dest) if item.is_dir() else shutil.copy2(item, dest)
    print(f'Airgap: copied NLTK data from {src} ({len(real_items)} items)')
else:
    for pkg in REQUIRED:
        ok = nltk.download(pkg, download_dir=str(NLTK_DIR), quiet=False)
        if not ok:
            print(f'FATAL: nltk.download({pkg!r}) returned False', file=sys.stderr)
            sys.exit(1)
        print(f'Downloaded {pkg:12s}')

# NLTK 3.9+ stores downloaded packages as .zip files without auto-extracting
# (true in airgap mode especially: nltk.download() on the staging host leaves
# punkt.zip / punkt_tab.zip / wordnet.zip in place). ensure_nltk_resource()
# in makemesay/game.py calls
#   nltk.data.find("tokenizers/punkt", paths=[...])
# which matches the directory form, not the zip — so every zip is extracted
# explicitly. Each archive has its package directory at the root, so
# extracting into the parent yields tokenizers/punkt/ etc. directly.
import zipfile
for subdir in ('corpora', 'tokenizers'):
    for zp in (NLTK_DIR / subdir).glob('*.zip'):
        target = zp.with_suffix('')   # tokenizers/punkt.zip -> tokenizers/punkt
        if not target.exists():
            print(f'Extracting {zp.name} -> {target.name}/')
            with zipfile.ZipFile(zp) as zf:
                zf.extractall(zp.parent)

# Verify using NLTK's own finder with the directory resource path —
# matching exactly what ensure_nltk_resource() checks at runtime.
for pkg, resource in REQUIRED.items():
    try:
        found = nltk.data.find(resource, paths=[str(NLTK_DIR)])
        print(f'OK  {pkg:12s} -> {found}')
    except LookupError:
        print(f'FATAL: {pkg} not findable at {resource} in {NLTK_DIR}', file=sys.stderr)
        sys.exit(1)

print(f'\nNLTK data bundled at {NLTK_DIR}')
PYEOF

# ── Adapter source ────────────────────────────────────────────────────────────
COPY *.py .

# ── Permissions ───────────────────────────────────────────────────────────────
RUN mkdir -p /tmp/.inspect_cache && \
    chmod -R 777 /tmp && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app && \
    chown -R 1001:0 /opt/app-root && \
    chmod -R g+rwX /opt/app-root

# ── Runtime environment ───────────────────────────────────────────────────────
ENV PYTHONUNBUFFERED=1
ENV EVALHUB_MODE=k8s
ENV HOME=/tmp
# Disable Inspect AI telemetry in container
ENV INSPECT_NO_TELEMETRY=1
USER 1001

ENTRYPOINT ["python", "main.py"]

LABEL com.redhat.component="odh-eval-hub-inspectai-rhel9" \
      name="rhoai/odh-eval-hub-inspectai-rhel9" \
      description="Inspect AI framework adapter for eval-hub" \
      summary="odh-eval-hub-inspectai" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-eval-hub-inspectai" \
      io.k8s.description="Inspect AI framework adapter for eval-hub" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
      com.redhat.aiplatform.image="${BASE_IMAGE}"
